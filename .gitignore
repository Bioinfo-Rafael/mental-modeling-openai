# Claude Code Orchestra local state
.claude/settings.local.json
.claude/settings.orchestra.json
.codex/config.orchestra.toml
CLAUDE.local.md
.claude/logs/
.claude/checkpoints/
.orchestra-backup-*/

# Python / tooling
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Downloaded datasets are reproducible inputs (see data/README.md and configs/sources.json).
data/llmx_data/
data/candidate_datasets/*/repository/
data/candidate_datasets/*/*.zip
data/candidate_datasets/*/extracted/

# Generated analyses and paid-pilot outputs from src/mtd_rl_xavier/tools.
outputs/**/*.csv
outputs/**/*.json
outputs/**/*.jsonl
outputs/**/*.partial
outputs/smoke/
outputs/smoke-episode.npz

# Experiment results under workspace/<NN_name>/results/ are shared in git;
# only run-time lock and partial-write files stay local.
workspace/**/results/**/.execution.lock
workspace/**/results/**/.lock
workspace/**/results/**/*.partial

# Local secrets (API keys)
.env
# weightreading bundles and runs (weights derived from checkpoints, transcripts)
outputs/weightreading/

# Translator / judge: customer scenarios, key points, and run outputs stay out of git (whole trees).
/private/
/outputs/translator/
/outputs/evaluation/
# intent_compare runs (rollout episodes, ACMI, npz, clips, viewers, Slurm logs) derive from partner checkpoints.
/outputs/intent_compare/
