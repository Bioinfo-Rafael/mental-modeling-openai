.venv/
__pycache__/
.pytest_cache/
.ipynb_checkpoints/
*.pyc
*.egg-info/
outputs/**/*.partial

# Downloaded datasets are reproducible inputs. LLM-Xavier source is tracked directly.
data/llmx_data/
data/candidate_datasets/*/repository/
data/candidate_datasets/*/*.zip
data/candidate_datasets/*/extracted/

# Generated analyses and paid-pilot outputs.
outputs/**/*.csv
outputs/**/*.json
outputs/**/*.jsonl
outputs/smoke/
outputs/smoke-episode.npz

# Experiment manifests, raw API responses, figures, and local caches are derived.
experiments/**/results/*
!experiments/**/results/.gitkeep

# Exp.1 prompt previews are shared; paid responses and other results stay ignored.
!experiments/01_prompt_preview/results/.started.json
!experiments/01_prompt_preview/results/manifest.json
!experiments/01_prompt_preview/results/manifest.csv
!experiments/01_prompt_preview/results/*.txt

# Exp.08 shared figures, summaries, and editable preview template.
!experiments/08_fewshot/results/analysis/
!experiments/08_fewshot/results/analysis/**
!experiments/08_fewshot/results/dry_run/
experiments/08_fewshot/results/dry_run/*
!experiments/08_fewshot/results/dry_run/preview_template.html
!experiments/08_fewshot/results/dry_run/preview.html
# Finder metadata is local, including inside shared result directories.
.DS_Store
