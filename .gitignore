outputs/**/*.partial
outputs/smoke/
outputs/smoke-episode.npz

# Experiment results under workspace/<NN_name>/results/ are shared in git;
# only run-time lock and partial-write files stay local.
workspace/**/results/**/.execution.lock
workspace/**/results/**/*.partial
